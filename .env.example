# ====================================================================
# NAVIRA ENVIRONMENT CONFIGURATION (.env)
# Mohali & Chandigarh Business Analysis & Marketplace Engine
# ====================================================================

# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / React)
VITE_API_URL=http://localhost:3002
VITE_ADMIN_EMAILS=navirabusiness01@gmail.com,himanshu@navira.in,admin@navira.in

# Optional custom SHA-256 hash override for local administrator key
# VITE_ADMIN_HASH=your_sha256_hash_here

# Optional Google OAuth Client ID for direct frontend Google Sign-In
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. BACKEND ENVIRONMENT VARIABLES (Node.js & Express - port 3002)
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JSON Web Token Secret Key (Change this to a strong random 64-character secret in production)
JWT_SECRET=navira_super_secret_jwt_signing_key_2026_mohali_chandigarh_production

# Authorized Administrator Email Whitelist (Comma-separated)
ADMIN_EMAILS=navirabusiness01@gmail.com,himanshu@navira.in,admin@navira.in

# Initial Administrator Seed Password
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here

# Google OAuth Credentials (From Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# 3. SUPABASE CONFIGURATION (When connecting Supabase)
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

